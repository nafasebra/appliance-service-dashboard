{
  "name": "appliance-service-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "tsx --tsconfig tsconfig.app.json --test src/entities/service/model/validation.test.ts src/app/tests/order-workflow.test.ts src/entities/service/model/customer-account.test.ts src/app/tests/stores.test.ts src/entities/inventory/model/parts.test.ts src/shared/lib/date.test.ts src/shared/lib/csv.test.ts src/shared/ui/data-table.test.ts src/app/i18n.test.ts src/features/finance/lib/cash-chart.test.ts src/entities/company/model/settings.test.ts src/shared/lib/utils.test.ts src/shared/ui/sidebar/sidebar.test.ts",
    "i18n:extract": "i18next-cli extract",
    "i18n:check": "i18next-cli status && i18next-cli lint",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "architecture:check": "node scripts/check-architecture.mjs"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "^5.3.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-jalali": "^4.4.0-0",
    "i18next": "^27.1.5",
    "lucide-react": "^1.73.0",
    "radix-ui": "^1.8.1",
    "react": "^19.1.1",
    "react-day-picker": "^9.11.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^18.0.2",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "husky": "^9.1.7",
    "i18next-cli": "^1.91.0",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",
    "vite": "^7.1.7"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
